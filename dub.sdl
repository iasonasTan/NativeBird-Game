name "native_bird"
description "A Flappy Bird game implementation with Dlang."
authors "iasonas"
copyright "Copyright © 2026, iasonas"
license "GPL-3.0-only"
dependency "dxml" version="0.4.0"
dependency "raylib-d" version="~>6.0.1"
dependency "arsd-official:dom" version="~>12.1.2"
targetType "executable"
stringImportPaths "res"
configuration "linux" {
	platforms "linux"
	targetType "executable"
	lflags "./libs/linux/libraylib.a" "-lGL" "-lm" "-lpthread" "-ldl" "-lrt" "-lX11"
}
configuration "windows" {
	platforms "windows"
	targetType "executable"
	lflags "/subsystem:windows" "/entry:mainCRTStartup"
	libs "opengl32" "gdi32" "winmm" "user32" "shell32" "msvcrt" "ucrt"
	sourceFiles "libs/win/raylib.lib"
}
